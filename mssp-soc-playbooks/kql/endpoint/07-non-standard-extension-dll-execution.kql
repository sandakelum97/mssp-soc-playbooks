// Title:   Non-standard extension DLL execution (RAT staging)
// Purpose: Detects rundll32 loading files with non-DLL extensions (.rfg, .dat,
//          .cfg, .tmp) - used by RATs to masquerade payloads as non-executable
//          files and evade extension-based detection.
// Env:     Microsoft Defender XDR - Advanced Hunting
// Tables:  DeviceProcessEvents
| where FileName =~ "rundll32.exe"
| where ProcessCommandLine matches regex @"(?i)\.(rfg|dat|cfg|tmp|log|txt)([\"", ]|$)"
// Extract the first argument (the payload rundll32 loads) and exclude payloads
// under C:\Windows. FolderPath can't be used - it is rundll32's own location.
| extend Payload = extract(@"(?i)rundll32(?:\.exe)?""?\s+""?([^,""]+)", 1, ProcessCommandLine)
| where isnotempty(Payload) and not(Payload startswith @"C:\Windows\")
| project Timestamp, DeviceName, AccountName, Payload,
          ProcessCommandLine, InitiatingProcessFileName
| order by Timestamp desc
