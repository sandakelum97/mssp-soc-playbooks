// Title:   Repeated connections to Microsoft auth endpoints (C2 blending)
// Purpose: Detects malware C2 traffic blending into legitimate Microsoft
//          authentication infrastructure via high-frequency connections
//          from unexpected processes. DeviceNetworkEvents does not record the
//          HTTP method, so this counts connections (bursts >= 3 per 5 minutes).
// Env:     Microsoft Defender XDR - Advanced Hunting
// Tables:  DeviceNetworkEvents
// MITRE:   T1071.001 - Application Layer Protocol: Web Protocols

DeviceNetworkEvents
// RemoteUrl usually holds only the FQDN for HTTPS traffic (no path), so match the host.
| where RemoteUrl has_any ("login.microsoftonline.com", "login.live.com")  // <-- adjust if needed
// Expect legitimate bursts from Teams/Outlook/OneDrive - tune the exclusion list below.
| where InitiatingProcessFileName !in~ (
    "svchost.exe", "lsass.exe", "msedge.exe",   // msedge.exe = Chromium Edge
    "MicrosoftEdge.exe", "chrome.exe", "firefox.exe"  // <-- tune per estate
  )
| summarize Count = count()
        by DeviceName, InitiatingProcessFileName, bin(Timestamp, 5m)
| where Count >= 3
