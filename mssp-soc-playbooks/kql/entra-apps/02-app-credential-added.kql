// Title:   New credential added to an application or service principal
// Purpose: Detects secrets/certificates added to app registrations or service
//          principals - a common persistence step after an app or admin
//          account is compromised. Review any change not made by the app owner
//          or through a known change request.
// Env:     Microsoft Sentinel / Log Analytics
// Tables:  AuditLogs
// MITRE:   T1098.001 - Account Manipulation: Additional Cloud Credentials
// Ref:     https://learn.microsoft.com/security/operations/incident-response-playbook-compromised-malicious-app

AuditLogs
| where TimeGenerated > ago(14d)  // <-- adjust
| where OperationName in (
    "Add service principal credentials",
    "Update application - Certificates and secrets management"
  )
   or OperationName has "Certificates and secrets management"  // hyphen/en-dash variants
| extend Actor    = coalesce(tostring(InitiatedBy.user.userPrincipalName),
                             tostring(InitiatedBy.app.displayName)),
         ActorIP  = tostring(InitiatedBy.user.ipAddress),
         Target   = tostring(TargetResources[0].displayName),
         TargetId = tostring(TargetResources[0].id),
         TargetType = tostring(TargetResources[0].type)
| project TimeGenerated, OperationName, Actor, ActorIP,
          Target, TargetType, TargetId, Result, CorrelationId
| order by TimeGenerated desc
