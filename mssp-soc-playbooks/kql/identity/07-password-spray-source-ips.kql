// Title:   Password spray - source IPs failing against many accounts
// Purpose: Finds IPs generating bad-password (50126) or smart-lockout (50053)
//          failures across many distinct users with few attempts per user -
//          the spray pattern - then shows whether the same IP achieved any
//          successful (0) or MFA-interrupted sign-ins, which are the
//          priority accounts to investigate.
//          Identity Protection's "Password spray" risk detection fires only
//          when a password is validated, so failed-only sprays need this hunt.
// Env:     Microsoft Sentinel / Log Analytics
// Tables:  SigninLogs
// MITRE:   T1110.003 - Brute Force: Password Spraying
// Ref:     https://learn.microsoft.com/security/operations/incident-response-playbook-password-spray

let lookback      = 1d;   // <-- adjust
let minUsers      = 10;   // <-- tune: distinct accounts targeted by one IP
let maxPerUser    = 5;    // <-- tune: low attempts per user = spray, not brute force
let failCodes     = dynamic(["50126", "50053"]);  // bad password, IdsLocked
let mfaInterrupts = dynamic(["50074", "50076", "50079"]);
SigninLogs
| where TimeGenerated > ago(lookback)
| summarize
    FailedUsers    = dcountif(UserPrincipalName, ResultType in (failCodes)),
    FailedAttempts = countif(ResultType in (failCodes)),
    SuccessUsers   = make_set_if(UserPrincipalName, ResultType == "0", 50),
    MfaInterrupted = make_set_if(UserPrincipalName, ResultType in (mfaInterrupts), 50),
    Apps           = make_set(AppDisplayName, 10),
    UserAgents     = make_set(UserAgent, 10),
    FirstSeen      = min(TimeGenerated),
    LastSeen       = max(TimeGenerated)
    by IPAddress, AutonomousSystemNumber
| where FailedUsers >= minUsers
| extend AttemptsPerUser = round(todouble(FailedAttempts) / FailedUsers, 1)
| where AttemptsPerUser <= maxPerUser
| extend PossibleCompromise = array_length(SuccessUsers) > 0 or array_length(MfaInterrupted) > 0
| project FirstSeen, LastSeen, IPAddress, AutonomousSystemNumber, FailedUsers,
          FailedAttempts, AttemptsPerUser, PossibleCompromise,
          SuccessUsers, MfaInterrupted, Apps, UserAgents
| order by PossibleCompromise desc, FailedUsers desc
